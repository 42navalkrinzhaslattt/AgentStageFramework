# Presidential Simulator configuration. Copy to game/.env (or the repo root .env).

# Theta EdgeCloud key: used by the framework Director (DeepSeek R1) and, if
# ON_DEMAND_API_ACCESS_TOKEN is unset, by the Llama and FLUX clients.
THETA_API_KEY=
# Optional: base URL for the framework's generic Theta client
# THETA_BASE_URL=https://api.thetaedgecloud.com

# Theta on-demand token for the Llama advisor endpoint and FLUX images
ON_DEMAND_API_ACCESS_TOKEN=
# Optional endpoint overrides
# LLAMA_CHAT_URL=
# ON_DEMAND_FLUX_URL=

# Google AI Studio key: Gemini fallback for advisors, evaluation and images
GOOGLE_AI_API_KEY=
# GEMINI_API_KEY=              (accepted for image generation if GOOGLE_AI_API_KEY is unset)
# GOOGLE_GEMINI_IMAGE_MODEL=   (default: gemini-2.5-flash-image-preview)

# Game tuning
# PRES_SIM_MAX_TURNS=5
# PRES_SIM_METRIC_MIN=40
# PRES_SIM_METRIC_MAX=70
